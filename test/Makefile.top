# =============================================================================
# ZIRH-3 - the CPU-carrying top: ISP end to end (import ladder rung 3)
#   make -C test -f Makefile.top
# =============================================================================
SIM ?= icarus
TOPLEVEL_LANG ?= verilog
SRC_DIR = $(PWD)/../src
SIM_BUILD = sim_build/top

VERILOG_SOURCES += $(SRC_DIR)/vex/VexRiscv_Lite.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_vex_wrap.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_tmr_lib.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_tmr_ff32.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_rom.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_bus.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_ecc_ram.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_rs422.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_uart_regs.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_soc.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_boot_ctrl.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_isp_rx.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_jtag_dm.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_dbg_gate.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_clkobs.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_por_ro.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_hk.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_tlm2.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_mbist.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_bank64.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_sram_bist.v
VERILOG_SOURCES += $(SRC_DIR)/zirh_sram39.v
SRAM_V = $(PDK_ROOT)/ihp-sg13g2/libs.ref/sg13g2_sram/verilog
VERILOG_SOURCES += $(SRAM_V)/RM_IHPSG13_1P_core_behavioral_bm_bist.v
VERILOG_SOURCES += $(SRAM_V)/RM_IHPSG13_1P_1024x8_c2_bm_bist.v
VERILOG_SOURCES += $(SRC_DIR)/zirh3_top.v

TOPLEVEL = zirh3_top
COCOTB_TEST_MODULES = test_top_isp

ROM_HEX ?= $(PWD)/../fw/rom.hex
COMPILE_ARGS += -Pzirh3_top.ROM_HEX=\"$(ROM_HEX)\"
COMPILE_ARGS += -Pzirh3_top.RESET_DIV=20
COMPILE_ARGS += -Pzirh3_top.POR_CYCLES=16
COMPILE_ARGS += -Pzirh3_top.INTERVAL_LOG2=13
COMPILE_ARGS += -Pzirh3_top.WD_LIMIT_LOG2=17
# 4 pages in sim for wall-clock; synthesis and the guard build all 16
COMPILE_ARGS += -Pzirh3_top.BANK_PAGES=4
COMPILE_ARGS += -I$(SRC_DIR)
COMPILE_ARGS += -DZIRH_SIM_ENV
# the PDK macro's behavioral write path lives behind FUNCTIONAL - without
# it the model swallows writes silently and every read is X (measured:
# the lw-X hunt of rung 4; the sram39 suite carries the same define)
COMPILE_ARGS += -DFUNCTIONAL

include $(shell cocotb-config --makefiles)/Makefile.sim
