# ZIRH-3 - the SV scenario suites (boot stories for now; the chip
# suite arrives with the chip top)
SRC_DIR := $(CURDIR)/../src
BUILD := sim_build/svs
.PHONY: boot fuzz clean
boot: $(BUILD)/boot.vvp
	vvp $(BUILD)/boot.vvp
fuzz: $(BUILD)/fuzz.vvp
	# EPISODES only overrides when the caller sets it: the bench's own
	# default scales with its kind count, and a hard 120 in this line
	# was silently starving the coverage gate every time a kind was
	# added - the bench-side fix was unreachable from here
	vvp $(BUILD)/fuzz.vvp +SEED=$(or $(SEED),1) $(if $(EPISODES),+EPISODES=$(EPISODES))
$(BUILD)/fuzz.vvp: sv/zirh_boot_fuzz_tb.sv $(SRC_DIR)/zirh_boot_ctrl.v $(SRC_DIR)/zirh_tmr_lib.v
	mkdir -p $(BUILD)
	iverilog -g2012 -DZIRH_ASSERTIONS -I$(SRC_DIR) -s zirh_boot_fuzz_tb -o $@ \
	  sv/zirh_boot_fuzz_tb.sv $(SRC_DIR)/zirh_boot_ctrl.v $(SRC_DIR)/zirh_tmr_lib.v
$(BUILD)/boot.vvp: sv/zirh_boot_scenarios_tb.sv $(SRC_DIR)/zirh_boot_ctrl.v $(SRC_DIR)/zirh_tmr_lib.v
	mkdir -p $(BUILD)
	iverilog -g2012 -DZIRH_ASSERTIONS -I$(SRC_DIR) -s zirh_boot_scenarios_tb -o $@ \
	  sv/zirh_boot_scenarios_tb.sv $(SRC_DIR)/zirh_boot_ctrl.v $(SRC_DIR)/zirh_tmr_lib.v
clean:
	rm -rf $(BUILD)
